PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=home_app
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Local development only. Allows Authorization: Bearer dev:admin.
DEV_AUTH_ENABLED=true

# Production/Firebase auth. Use one of these when DEV_AUTH_ENABLED is false.
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
